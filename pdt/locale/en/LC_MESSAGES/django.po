#: apps/interviews/views.py:55
#, python-format
msgid "São necessários %(pct)s%% para subir de nível."
msgstr "You need %(pct)s%% to level up."

#: apps/interviews/views.py:57
#, python-format
msgid "Faltou pouco. %(rule)s Revise o gabarito e tente de novo."
msgstr "So close. %(rule)s Review the answer key and try again."

#: apps/interviews/views.py:60
#, python-format
msgid ""
"Você está no caminho, mas ainda não passou. %(rule)s Estude os pontos onde "
"errou no gabarito antes de refazer."
msgstr ""
"You're on the right track, but haven't passed yet. %(rule)s Study the points "
"you missed in the answer key before retaking it."

#: apps/interviews/views.py:65
#, python-format
msgid ""
"Ainda há terreno a cobrir. %(rule)s Use o gabarito como guia de estudos "
"antes de tentar de novo."
msgstr ""
"There's still ground to cover. %(rule)s Use the answer key as a study guide "
"before trying again."

#: apps/interviews/views.py:69
#, python-format
msgid ""
"O resultado mostra que vale estudar o conteúdo antes de refazer. %(rule)s "
"Comece pelo gabarito e pelos tópicos relacionados na trilha."
msgstr ""
"The result shows it's worth studying the material before retaking it. "
"%(rule)s Start with the answer key and the related topics in the track."

#: apps/interviews/views.py:151
msgid "Você ainda não desbloqueou esse nível. Conclua o anterior com 80%+."
msgstr ""
"You haven't unlocked this level yet. Complete the previous one with 80%+."

#: apps/interviews/views.py:180
#, python-format
msgid ""
"Banco de questões incompleto para %(level)s (%(n)s/%(total)s). Avise o admin."
msgstr ""
"Question bank incomplete for %(level)s (%(n)s/%(total)s). Let the admin know."

#: apps/interviews/views.py:284
msgid "Progresso salvo. Você pode retomar a qualquer momento."
msgstr "Progress saved. You can resume anytime."

#: apps/interviews/views.py:356
#, python-format
